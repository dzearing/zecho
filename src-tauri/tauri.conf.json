{
  "productName": "Zecho",
  "version": "0.7.2",
  "identifier": "com.dzearing.zecho",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pill",
        "title": "Zecho",
        "width": 220,
        "height": 46,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": true
      },
      {
        "label": "setup",
        "title": "Welcome to Zecho",
        "url": "setup.html",
        "width": 520,
        "height": 680,
        "decorations": true,
        "resizable": false,
        "visible": false,
        "center": true
      },
      {
        "label": "history",
        "title": "Zecho History",
        "url": "history.html",
        "width": 300,
        "height": 500,
        "decorations": true,
        "resizable": true,
        "visible": false,
        "center": true
      },
      {
        "label": "settings",
        "title": "Zecho Settings",
        "url": "settings.html",
        "width": 720,
        "height": 780,
        "decorations": true,
        "resizable": false,
        "visible": false,
        "center": true
      },
      {
        "label": "update",
        "title": "Zecho Updates",
        "url": "update.html",
        "width": 440,
        "height": 320,
        "decorations": true,
        "resizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/32x32.png"
    ],
    "resources": [],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "Developer ID Application: DAVID BENJAMIN ZEARING (VMGW2V57S7)",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/dzearing/zecho/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2NkU2Q0JFODQ2OEU4NUYKUldSZjZHaUV2bXh1SmhSaGQzcjdRT0dwb09SWGM5VThxTGZDcTVnN3BmWjI4ckM4NnZKOGVJZ24K"
    }
  }
}